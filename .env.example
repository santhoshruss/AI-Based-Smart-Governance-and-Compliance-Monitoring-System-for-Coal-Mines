# =====================================================================
# Coal Governance Platform — Environment Variables
# For Local Dev or Cloud Deployment (Neon DB + Render + Vercel)
# =====================================================================

# ---- Application & Port ----
APP_PORT=8080
PORT=8080
CORS_ORIGINS=*

# ---- Database (Neon DB or Local PostgreSQL) ----
# Neon DB Connection String (Recommended for Cloud):
DATABASE_URL=postgresql://neondb_owner:npg_p9oxyTHtrjf0@ep-winter-resonance-b4f55yxq-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Or discrete credentials (Local PostgreSQL fallback):
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=coal_governance
DB_SSLMODE=disable

# ---- JWT Authentication ----
JWT_SECRET=change_me_to_a_long_random_string_in_production
JWT_EXPIRY_HOURS=12

# ---- Storage & Cron ----
UPLOAD_DIR=./uploads
SLA_CRON_SCHEDULE=@hourly
GEOFENCE_RADIUS_M=500.0

# ---- AI Microservice ----
AI_SERVICE_URL=http://localhost:5000

# ---- Gemini AI Integration (Google AI Studio) ----
GEMINI_API_KEY=your_gemini_api_key_here
